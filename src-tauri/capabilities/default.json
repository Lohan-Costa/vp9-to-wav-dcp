{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões padrão para a janela principal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "ffmpeg",  "sidecar": true },
        { "name": "ffprobe", "sidecar": true }
      ]
    },
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:default"
  ]
}
